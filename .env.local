TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IMOOD_EMAIL=
IMOOD_PASSWORD=
IMOOD_USERNAME=
ALLOWED_ORIGIN=
CRON_SECRET=
TELEGRAM_SECRET_TOKEN=

# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, IMOOD_EMAIL, IMOOD_PASSWORD, and IMOOD_USERNAME
# must match your actual accounts — see README.md for where to get each one.
#
# CRON_SECRET and TELEGRAM_SECRET_TOKEN are values you make up yourself, not
# issued by anything. Any random string works, e.g. generate one with:
#   openssl rand -hex 32
#
# ALLOWED_ORIGIN is optional. It's the site domain allowed to read the public
# ?action=status endpoint from browser JavaScript (CORS). Leave it blank if
# you're not embedding your mood status on another website.
#
# This file is a template — keep it committed with blank values.
# Or list this file into .gitignore
# Set the real values in your Vercel project settings for production.
# Never commit real secrets here.
